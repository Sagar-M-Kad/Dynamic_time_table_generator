# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.

# Supabase project credentials (Settings → API in your Supabase dashboard)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_KEY=your_supabase_anon_key

# Google Gemini fallback API key (optional — keys can also be managed via Settings page)
REACT_APP_GEMINI_KEY=your_gemini_api_key

# Portal Admin Credentials (optional override for local administration)
REACT_APP_ADMIN_USER=admin
REACT_APP_ADMIN_PASS=admin123
